{
  "name": "ssente-zaffe",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "keygen": "tsx packages/core/src/cli-keygen.ts",
    "ingest": "tsx packages/ingest/src/cli-ingest.ts",
    "verify": "tsx packages/core/src/cli-verify.ts",
    "dev": "npm run dev --workspace @ssente/reader",
    "build": "npm run build --workspace @ssente/reader",
    "reports": "tsx packages/reports/src/server.ts",
    "ussd": "tsx packages/ussd/src/server.ts",
    "key:ci": "tsx packages/core/src/cli-key-from-env.ts",
    "start:reports": "node packages/reports/src/server.ts",
    "start:ussd": "node packages/ussd/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
  }
}